{
  "name": "paas-express-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paas-students-db",
      "database_id": "2dd9f26d-625a-4379-86af-7bda53b27cfc"
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "48271905", "simple": { "limit": 5, "period": 60 } }
  ],
  "secrets": { "required": ["JWT_SECRET"] },
  "observability": {
    "enabled": true
  }
}
